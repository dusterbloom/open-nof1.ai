{
    "version": "1.0",
    "description": "Skill activation triggers for MCP SME Toolkit project. Controls when skills automatically suggest actions.",
    "skills": {
        "skill-developer": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Meta-skill for creating and managing Claude Code skills",
            "promptTriggers": {
                "keywords": [
                    "skill system",
                    "create skill",
                    "add skill",
                    "skill triggers",
                    "skill rules",
                    "hook system",
                    "skill development",
                    "skill-rules.json",
                    "claude code infrastructure"
                ],
                "intentPatterns": [
                    "(how do|how does|explain).*?skill",
                    "(create|add|modify|build).*?skill",
                    "skill.*?(work|trigger|activate|system)"
                ]
            }
        },
        "mcp-builder": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Official Anthropic guide for building MCP servers with Python FastMCP framework. Covers tool design, input validation, response formatting, error handling, and evaluation. Use when implementing MCP servers, creating MCP tools, or working with Model Context Protocol.",
            "promptTriggers": {
                "keywords": [
                    "MCP server",
                    "build MCP",
                    "create MCP",
                    "MCP tool",
                    "FastMCP",
                    "MCP protocol",
                    "tool implementation",
                    "MCP best practices",
                    "implement tool",
                    "MCP development",
                    "Model Context Protocol"
                ],
                "intentPatterns": [
                    "(create|build|implement|design).*?(MCP|server|tool)",
                    "(how to|how do I).*?(MCP|server)",
                    "MCP.*?(best practice|pattern|guide)",
                    "(implement|create).*?tool",
                    "(build|develop).*?(server|MCP)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "mcp-servers/**/*.py",
                    "mcp-core/**/*.py",
                    "mcp-client/**/*.py"
                ],
                "contentPatterns": [
                    "@mcp\\.tool",
                    "from mcp import",
                    "FastMCP",
                    "class.*MCP",
                    "mcp\\.tool\\("
                ]
            }
        }
    },
    "notes": {
        "enforcement_types": {
            "suggest": "Skill suggestion appears but doesn't block execution",
            "block": "Requires skill to be used before proceeding (guardrail)",
            "warn": "Shows warning but allows proceeding"
        },
        "priority_levels": {
            "critical": "Highest - Always trigger when matched",
            "high": "Important - Trigger for most matches",
            "medium": "Moderate - Trigger for clear matches",
            "low": "Optional - Trigger only for explicit matches"
        },
        "customization": {
            "pathPatterns": "Adjust to match your MCP server structure",
            "keywords": "Add MCP and domain-specific terms",
            "intentPatterns": "Use regex for flexible user intent matching"
        }
    }
}
