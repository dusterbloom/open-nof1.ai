NEXT_PUBLIC_URL="http://localhost:3000"
DEEPSEEK_API_KEY="xxx"
OPENROUTER_API_KEY="xxx"
EXA_API_KEY="xxx"
BINANCE_API_KEY="xxx"
BINANCE_API_SECRET="xxx"
BINANCE_USE_SANDBOX="true" # DEPRECATED: Binance testnet no longer works for futures

# Trading Mode Configuration
# Options: "live" or "dry_run"
# - "dry_run": Simulate trades without real money (no API keys required, set to empty strings)
# - "live": Real trading with actual money
TRADING_MODE="dry_run"
NEXT_PUBLIC_TRADING_MODE="dry_run" # Must match TRADING_MODE (exposed to browser for UI indicator)

DATABASE_URL="postgresql://postgres:root@localhost:5432/xxx"
CRON_SECRET_KEY="xxxx"
START_MONEY=30